# Copy this file to .env and supply your site's public Google identifiers.
# Netlify builds already receive these public values from netlify.toml.
# This template is for local development outside Netlify.

# Use pub- followed by the 16 digits from your AdSense account (without ca-).
ADSENSE_PUBLISHER_ID=

# Copy only the content value of the Search Console verification meta tag.
GOOGLE_SITE_VERIFICATION=
